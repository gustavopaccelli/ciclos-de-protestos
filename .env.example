# Copie para .env e preencha. NUNCA commite o .env.
FOLHA_EMAIL=seu-email@exemplo.com
FOLHA_PASSWORD=sua-senha
# Acervos do Estadão e de O Globo (config/veiculos/estadao.yaml e oglobo.yaml)
ESTADAO_EMAIL=
ESTADAO_PASSWORD=
OGLOBO_EMAIL=
OGLOBO_PASSWORD=
ANTHROPIC_API_KEY=sk-ant-...
# Modelo do codificador AEP-BR (src/preprocessing/coder.py). Padrão: claude-opus-5-5.
# DOCA_EFFORT ajusta a profundidade de raciocínio (low|medium|high|xhigh|max; padrão high).
DOCA_MODEL=claude-opus-5-5
DOCA_EFFORT=high

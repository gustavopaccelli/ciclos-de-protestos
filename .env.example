# Environment Configuration Template
# Copy this file to .env and fill in your local values
# .env is .gitignored and should never be committed

# ============================================================================
# Data Paths
# ============================================================================
# Paths to data directories (relative or absolute)
RAW_DATA_PATH=data/raw/
INTERIM_DATA_PATH=data/interim/
PROCESSED_DATA_PATH=data/processed/
OUTPUTS_FIGURES_PATH=outputs/figures/
OUTPUTS_TABLES_PATH=outputs/tables/

# ============================================================================
# API Keys (if needed for data collection)
# ============================================================================
# Example: API keys for news archives, databases, etc.
API_KEY_FOLHA=
API_KEY_GLOBO=
API_KEY_ACADEMIC_DATABASE=

# ============================================================================
# Database Configuration (if using)
# ============================================================================
# Database connection strings for external data sources
DB_HOST=localhost
DB_PORT=5432
DB_NAME=protest_cycles
DB_USER=
DB_PASSWORD=

# ============================================================================
# Logging and Debug
# ============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Verbose output (true/false)
VERBOSE=false

# ============================================================================
# Data Processing Configuration
# ============================================================================
# Random seed for reproducibility
RANDOM_SEED=42

# Encoding for text files
TEXT_ENCODING=utf-8

# Language for NLP processing (Portuguese: pt, English: en)
NLP_LANGUAGE=pt

# ============================================================================
# Research Configuration
# ============================================================================
# Researcher name/ID
RESEARCHER_ID=GP

# Research start date (ISO format)
RESEARCH_START_DATE=2023-01-01

# Data collection methods: "scraping", "manual", "hybrid"
DATA_COLLECTION_METHOD=hybrid

# ============================================================================
# Parallel Processing
# ============================================================================
# Number of processes for parallel tasks
N_PROCESSES=4

# Batch size for processing
BATCH_SIZE=100

# ============================================================================
# Quality Assurance
# ============================================================================
# Minimum acceptable intercoder reliability (alpha)
MIN_INTERCODER_ALPHA=0.70

# Minimum data completeness percentage for inclusion
MIN_COMPLETENESS=0.80

# ============================================================================
# Advanced/Internal Configuration
# ============================================================================
# Cache directory for intermediate results
CACHE_DIR=.cache/

# Temporary files directory
TEMP_DIR=.tmp/

# Development mode (true/false) - enables debug info and verbosity
DEVELOPMENT_MODE=false
